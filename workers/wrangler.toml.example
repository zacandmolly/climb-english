name = "climb-english-feedback"
main = "speaking-feedback-worker.mjs"
compatibility_date = "2026-05-26"

[vars]
ALLOWED_ORIGINS = "https://zacandmolly.github.io,http://127.0.0.1:5173,http://localhost:5173"
OPENAI_TRANSCRIBE_MODEL = "gpt-4o-mini-transcribe"
OPENAI_FEEDBACK_MODEL = "gpt-4.1-mini"
DAILY_REQUEST_LIMIT = "300"
HOURLY_REQUEST_LIMIT = "90"
PER_IP_HOURLY_LIMIT = "35"
MAX_AUDIO_BYTES = "10485760"

[[kv_namespaces]]
binding = "FEEDBACK_USAGE"
id = "replace-with-cloudflare-kv-namespace-id"
