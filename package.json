{
  "name": "climb-english",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/port-guard.mjs && node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:lessons": "node scripts/build-official-lessons.mjs",
    "import:youtube": "node scripts/import-youtube.mjs",
    "discover:youtube": "node scripts/discover-youtube.mjs",
    "translate:videos": "node scripts/translate-videos.mjs",
    "check:alignment": "node scripts/check-cue-alignment.mjs",
    "oxidize": "node scripts/oxidize-report.mjs",
    "lint": "eslint \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "lint:complexity": "eslint \"src/**/*.{ts,tsx}\"",
    "depcruise": "depcruise src --config .dependency-cruiser.js --output-type err",
    "knip": "knip",
    "deadcss": "node scripts/find-dead-css.mjs",
    "format": "prettier --write \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "prepare": "husky",
    "test": "node --test \"tests/*.test.mjs\"",
    "m1:install-deepseek-key": "node scripts/m1-feedback-api.mjs install-deepseek-key",
    "m1:install-key": "node scripts/m1-feedback-api.mjs install-key",
    "m1:status": "node scripts/m1-feedback-api.mjs status",
    "m1:test": "node scripts/m1-feedback-api.mjs test",
    "m1:usage": "node scripts/m1-feedback-api.mjs usage",
    "preview": "NODE_ENV=production node server/index.mjs",
    "worker:deploy": "npx wrangler deploy --config workers/wrangler.toml",
    "worker:dev": "npx wrangler dev --config workers/wrangler.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "multer": "^2.0.2",
    "openai": "^6.10.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.67.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "purgecss": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "scripts/**/*.mjs": [
      "prettier --write",
      "eslint --fix"
    ],
    "tests/**/*.mjs": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
