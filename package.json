{
  "name": "climb-english",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "m1:install-key": "node scripts/m1-feedback-api.mjs install-key",
